# HubSpot Configuration
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_ACCOUNT_ID=your-hubspot-account-id

# Zohal Identity Service Configuration
ZOHAL_API_URL=https://service.zohal.io/api/v0
ZOHAL_API_TOKEN=your-zohal-api-token

# SMS/OTP Provider Configuration
SMS_PROVIDER=kavenegar  # or twilio, aws-sns
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_SENDER=BaleBot

# Twilio (alternative)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# General Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
SESSION_EXPIRY_MINUTES=30
ENVIRONMENT=development
LOG_LEVEL=debug
